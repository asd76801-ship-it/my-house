function refine(x,mkr,c){if(x[3]==='P')return;const k=ck((x[5]||x[0])+(x[3]==='U'?'|u':''));const apply=p=>{x[1]=p[0];x[2]=p[1];x[3]='K';mkr.setPosition(ll(p[0]+(c==='out'?.00018:0),p[1]+(c==='out'?.00018:0)));mkr.el.firstChild.classList.add('k');mkr.el.firstChild.classList.remove('a')};
 if(cache[k]){if(cache[k]!=='-')apply(cache[k]);return}
 q.push([x,apply,k]);pump()}
function pump(){if(busy||!q.length)return;busy=true;const [x,apply,k]=q.shift();
 const done=()=>{busy=false;setTimeout(pump,60)};
 if(cache[k]){if(cache[k]!=='-')apply(cache[k]);return done()}
 const U=x[3]==='U';ps.keywordSearch((U?x[5]:x[0]).replace(/\(.*?\)/g,'').replace(/ 앞$/,''),(res,st)=>{let hit=null;if(st===kakao.maps.services.Status.OK){for(const r of res){if(dist(x[1],x[2],+r.y,+r.x)<(U?6:3)){hit=[+r.y,+r.x];break}}}
  cache[k]=hit||'-';saveCache();if(hit)apply(hit);done()},{location:ll(x[1],x[2]),radius:x[3]==='U'?10000:3000,size:5,sort:kakao.maps.services.SortBy.DISTANCE})}
function mk(x,c,rs,num){
