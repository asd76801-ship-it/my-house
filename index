 s.onload=()=>{try{if(!window.kakao||!kakao.maps||!kakao.maps.load){clearTimeout(tm);return no('카카오가 키를 거부했습니다. JavaScript 키가 맞는지(REST API 키 아님), 카카오맵 사용 설정이 ON인지, 플랫폼 Web 도메인이 지금 주소('+location.origin+')와 똑같이 등록됐는지 확인하세요.')}
