:root{--bg:#f3f5f8;--panel:#ffffff;--fg:#17202e;--mute:#5d6b7e;--line:#d9dfe8;--in:#1b5fc4;--in-soft:#e3edfb;--out:#d9561a;--out-soft:#fbe9df;--site:#17202e;--map:#e7ebf0;
