:root[data-theme="dark"]{--bg:#10151d;--panel:#18202b;--fg:#e6ebf2;--mute:#97a4b6;--line:#2b3644;--in:#6aa4ff;--in-soft:#1b2c47;--out:#ff8a52;--out-soft:#3b2518;--site:#e6ebf2;--map:#1d2530;color-scheme:dark}
html,body{height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:14px;line-height:1.45;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:10px;box-sizing:border-box;display:flex;flex-direction:column;gap:10px}
h1{font-size:17px;margin:0;font-weight:700}
.top{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:flex-end}
.grp{display:flex;flex-direction:column;gap:4px;min-width:0}
.grp>label,.grp>span.l{font-size:11px;color:var(--mute);letter-spacing:.04em}
.seg{display:flex;flex-wrap:wrap;gap:4px}
button.c{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--panel);color:var(--fg);padding:5px 11px;border-radius:6px;cursor:pointer}
button.c:focus-visible,input:focus-visible,.rt:focus-visible{outline:2px solid var(--in);outline-offset:1px}
button.c[aria-pressed=true]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
button.c.in[aria-pressed=true]{background:var(--in);border-color:var(--in);color:#fff}
button.c.out[aria-pressed=true]{background:var(--out);border-color:var(--out);color:#fff}
