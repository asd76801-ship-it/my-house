.main{flex:1;min-height:0;display:grid;grid-template-columns:minmax(280px,360px) 1fr;gap:10px}
.side{display:flex;flex-direction:column;min-height:0;background:var(--panel);border:1px solid var(--line);border-radius:8px}
.sh{padding:8px 12px;border-bottom:1px solid var(--line);font-size:12px;color:var(--mute)}
.list{overflow:auto;flex:1;min-height:0}
.rt{display:block;width:100%;text-align:left;font:inherit;color:inherit;background:none;border:0;border-bottom:1px solid var(--line);padding:8px 12px;cursor:pointer}
.rt:hover{background:var(--bg)}
.rt[aria-pressed=true]{background:var(--bg);box-shadow:inset 3px 0 0 var(--fg)}
.rt .a{display:flex;gap:6px;align-items:center;min-width:0}
.rt .nm{font-weight:500;overflow-wrap:anywhere}
.rt .tm{font-family:var(--mono);font-size:12px;color:var(--mute);overflow-wrap:anywhere}
.tag{font-size:11px;padding:0 6px;border-radius:4px;flex:none;font-weight:700}
.tag.in{background:var(--in-soft);color:var(--in)}.tag.out{background:var(--out-soft);color:var(--out)}
.tag.s{border:1px solid var(--line);color:var(--mute);font-weight:500}
.mapw{position:relative;min-height:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--map)}
#map{position:absolute;inset:0;background:var(--map);font-family:var(--sans)}
.legend{position:absolute;left:10px;bottom:10px;z-index:900;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:12px;display:flex;flex-wrap:wrap;gap:4px 12px;max-width:calc(100% - 20px)}
.legend span{display:inline-flex;align-items:center;gap:5px}
.note{font-size:12px;color:var(--mute)}
